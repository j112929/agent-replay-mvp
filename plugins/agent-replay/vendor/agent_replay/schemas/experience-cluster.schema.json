{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/j112929/agent-replay-mvp/schema/experience-cluster.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "experience.cluster.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "enum": [
        "application",
        "infrastructure",
        "unknown"
      ]
    },
    "family_id": {
      "type": "string",
      "minLength": 1
    },
    "member_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "representative_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "method": {
      "enum": [
        "automatic",
        "reviewed"
      ]
    },
    "config_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "review": {
      "type": "object",
      "properties": {
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "reviewer",
        "reason"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "id",
    "label",
    "domain",
    "family_id",
    "member_ids",
    "representative_ids",
    "confidence",
    "method",
    "config_digest"
  ],
  "additionalProperties": false
}
