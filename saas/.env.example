# Copy to .env (ignored by git), then use npm run start:env.
GUARD_ORIGIN=http://127.0.0.1:3000
PORT=3000
GUARD_DATA_DIR=.replay/saas
# Generate: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
BETTER_AUTH_SECRET=
# Development is loopback-only. Production requires HTTPS, SMTP and a strong secret.
NODE_ENV=development
GUARD_SMTP_URL=
GUARD_MAIL_FROM=Agent Regression Guard <guard@example.invalid>
# Test keys only. Leave blank to run the offline product demo without Stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_BUSINESS=
