{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/j112929/agent-replay-mvp/schema/experience-dataset.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "experience.dataset.v1"
    },
    "profile": {
      "enum": [
        "scenario",
        "evaluated-experience",
        "policy-rollout"
      ]
    },
    "schema_versions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "splits": {
      "type": "object",
      "properties": {
        "train": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "validation": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "test": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "train",
        "validation",
        "test"
      ],
      "additionalProperties": false
    },
    "eligibility": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "eligible",
            "blocked",
            "unknown"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "state",
        "reasons"
      ],
      "additionalProperties": false
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "artifact_digest",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "generation": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "profile",
    "schema_versions",
    "artifacts",
    "splits",
    "eligibility",
    "exclusions",
    "generation"
  ],
  "additionalProperties": false
}
