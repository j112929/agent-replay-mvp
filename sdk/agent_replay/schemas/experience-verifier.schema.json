{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/j112929/agent-replay-mvp/schema/experience-verifier.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "experience.verifier.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evaluator_id": {
      "type": "string",
      "minLength": 1
    },
    "assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "op": {
            "enum": [
              "equals",
              "not_equals",
              "exists",
              "lte",
              "gte",
              "contains",
              "count",
              "forbidden",
              "execution_completed",
              "no_unhandled_error"
            ]
          },
          "select": {
            "type": "object"
          },
          "path": {
            "type": "string"
          },
          "expected": {},
          "quantifier": {
            "enum": [
              "all",
              "any"
            ]
          }
        },
        "required": [
          "id",
          "op"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "requirement_digests": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "qualification": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "draft",
            "qualified",
            "rejected"
          ]
        },
        "evidence_digests": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "state",
        "evidence_digests"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "id",
    "evaluator_id",
    "assertions",
    "requirement_digests",
    "qualification"
  ],
  "additionalProperties": false
}
