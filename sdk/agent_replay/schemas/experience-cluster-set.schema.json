{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/j112929/agent-replay-mvp/schema/experience-cluster-set.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "experience.cluster-set.v1"
    },
    "records_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "config": {
      "type": "object",
      "properties": {
        "algorithm_version": {
          "const": "deterministic.v1"
        },
        "similarity_threshold": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 1
        },
        "min_cluster_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      },
      "required": [
        "algorithm_version",
        "similarity_threshold",
        "min_cluster_size"
      ],
      "additionalProperties": false
    },
    "config_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "member_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "review": {
            "type": "object",
            "properties": {
              "reviewer": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "reviewer",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "member_ids",
          "label",
          "review"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "clusters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "schema_version": {
            "const": "experience.cluster.v1"
          },
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "domain": {
            "enum": [
              "application",
              "infrastructure",
              "unknown"
            ]
          },
          "family_id": {
            "type": "string",
            "minLength": 1
          },
          "member_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "representative_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "method": {
            "enum": [
              "automatic",
              "reviewed"
            ]
          },
          "config_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "review": {
            "type": "object",
            "properties": {
              "reviewer": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "reviewer",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "schema_version",
          "id",
          "label",
          "domain",
          "family_id",
          "member_ids",
          "representative_ids",
          "confidence",
          "method",
          "config_digest"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "outliers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "failure_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "failure_id",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "records_digest",
    "config",
    "config_digest",
    "overrides",
    "clusters",
    "outliers"
  ],
  "additionalProperties": false
}
