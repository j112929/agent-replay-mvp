{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/j112929/agent-replay-mvp/schema/experience-overrides.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "experience.overrides.v1"
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "member_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "review": {
            "type": "object",
            "properties": {
              "reviewer": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "reviewer",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "member_ids",
          "label",
          "review"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "groups"
  ],
  "additionalProperties": false
}
