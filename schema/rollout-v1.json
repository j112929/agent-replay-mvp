{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-replay.dev/schema/rollout-v1.json",
  "title": "Versioned RL rollout episode",
  "type": "object",
  "required": [
    "schema_version",
    "policy_version",
    "policy_digest",
    "environment",
    "seed",
    "transitions"
  ],
  "properties": {
    "schema_version": {
      "const": "rollout.v1"
    },
    "policy_version": {
      "type": "integer",
      "minimum": 0
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": "integer"
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": {
        "type": "object",
        "required": [
          "observation",
          "action",
          "next_observation",
          "behavior_logprob",
          "terminated",
          "truncated"
        ],
        "properties": {
          "observation": {},
          "action": {},
          "next_observation": {},
          "behavior_logprob": {
            "type": "number",
            "maximum": 0
          },
          "terminated": {
            "type": "boolean"
          },
          "truncated": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
