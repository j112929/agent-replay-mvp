{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/j112929/agent-replay-mvp/schema/regression-result.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "verdict": {
      "enum": [
        "pass",
        "fail",
        "error",
        "inconclusive",
        "not_evaluated"
      ]
    },
    "assertions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "fidelity": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "id",
    "case_id",
    "verdict",
    "assertions"
  ]
}
