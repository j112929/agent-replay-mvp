{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/j112929/agent-replay-mvp/schema/experience-environment.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "experience.environment.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "adapter_id": {
      "type": "string",
      "minLength": 1
    },
    "initial_state": {
      "type": "object"
    },
    "fixture_digests": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "asset_digests": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "dependency_versions": {
      "type": "object"
    },
    "reset_adapter_id": {
      "type": "string",
      "minLength": 1
    },
    "limits": {
      "type": "object",
      "properties": {
        "timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3600
        },
        "max_steps": {
          "type": "integer",
          "minimum": 0
        },
        "max_model_calls": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "timeout_seconds",
        "max_steps",
        "max_model_calls"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "id",
    "adapter_id",
    "initial_state",
    "fixture_digests",
    "asset_digests",
    "dependency_versions",
    "reset_adapter_id",
    "limits"
  ],
  "additionalProperties": false
}
